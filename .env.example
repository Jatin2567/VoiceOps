# VoiceOps Enterprise Environment Configuration
# Provider pricing and quotas depend on your account.

# ==============================================================================
# General Application Settings
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_API_URL=http://localhost:8000

# ==============================================================================
# Cascade and Hybrid: Groq Cloud API (Whisper STT & Groq LLM Logic)
# Quotas depend on your Groq account.
# Obtain from: https://console.groq.com/keys
# ==============================================================================
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b

# ==============================================================================
# State & Asynchronous Outbox Queue: Upstash Redis
# Free tier: 10,000 commands/day serverless Redis
# Obtain from: https://console.upstash.com/redis
# ==============================================================================
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
# Optional fallback standard Redis URL (e.g. local Docker container)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Persistence & Metrics Store: Supabase PostgreSQL
# Free tier: 500MB serverless Postgres with Connection Pooling
# Obtain from: https://supabase.com/dashboard
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project-id.supabase.co:5432/postgres

# ==============================================================================
# Edge-TTS Audio Generation (Zero-Cost Microsoft Edge TTS)
# Uses edge-tts python library directly (no API key required)
# ==============================================================================
EDGE_TTS_VOICE=en-US-ChristopherNeural
